# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
.env.local.example
*.sh
*.txt
# but never hide a real text asset that belongs on the site
!public/**/*.txt
posts.json
import-wp-news.cjs
retag-careers.cjs
asset-map.json

# local Sanity export archives (backups run in CI)
ibejulekki-production-*.tar.gz
